{
  "name": "@einhasad-vue/vue-wysiwyg",
  "version": "0.0.0",
  "description": "Tiny, modular, XSS-safe WYSIWYG editor for Vue 3 with a headless core, Markdown and HTML input/output",
  "keywords": [
    "vue",
    "vue3",
    "wysiwyg",
    "rich-text",
    "editor",
    "contenteditable",
    "markdown",
    "headless",
    "sanitizer",
    "xss",
    "typescript"
  ],
  "homepage": "https://github.com/einhasad/vue-wysiwyg#readme",
  "bugs": "https://github.com/einhasad/vue-wysiwyg/issues",
  "license": "MIT",
  "author": "Dmytro Popov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/einhasad/vue-wysiwyg.git"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sanitize": {
      "types": "./dist/sanitize/index.d.ts",
      "import": "./dist/sanitize/index.js"
    },
    "./normalize": {
      "types": "./dist/normalize/index.d.ts",
      "import": "./dist/normalize/index.js"
    },
    "./modules/*": {
      "types": "./dist/modules/*.d.ts",
      "import": "./dist/modules/*.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --config vite.fixture.config.ts",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
    "size": "npm run build && size-limit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test:coverage && npm run size"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@size-limit/esbuild": "^14.3.0",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "size-limit": "^14.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  }
}
